<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active State (Checked) -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#1F2937" /> <!-- Neutral Dark Charcoal -->
            <stroke
                android:width="2dp"
                android:color="#00E5FF" /> <!-- Vibrant Cyan Blue Glow -->
            <size android:width="48dp" android:height="28dp" />
        </shape>
    </item>

    <!-- Inactive State (Unchecked) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="#111827" /> <!-- Deeper Neutral -->
            <stroke
                android:width="1.5dp"
                android:color="#374151" /> <!-- Subtle Dark Gray Stroke -->
            <size android:width="48dp" android:height="28dp" />
        </shape>
    </item>
</selector>
