<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/ivFullImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/full_doc_image_desc"
        android:scaleType="matrix" />

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_circle_light_gray"
        android:backgroundTint="#80000000"
        android:contentDescription="@string/go_back_desc"
        android:src="@drawable/outline_arrow_back_24"
        app:tint="#FFFFFF" />

    <!-- Bottom Info Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvViewerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/doc_name_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvViewerTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/doc_tag_placeholder"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />
    </LinearLayout>

</RelativeLayout>