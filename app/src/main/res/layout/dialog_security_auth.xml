<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#1A222A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Icon Header -->
        <ImageView
            android:id="@+id/ivSecurityIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/green_primary" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvAuthTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Protected Space"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvAuthSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Enter PIN to unlock contents"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- PIN Entry Dots Indicator -->
        <LinearLayout
            android:id="@+id/llPinDots"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/dot2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/dot3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/dot4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pin_dot_empty" />
        </LinearLayout>

        <!-- Keypad Grid -->
        <GridLayout
            android:id="@+id/gridKeypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="3"
            android:rowCount="4"
            android:alignmentMode="alignMargins">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="4"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey5"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="5"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey6"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="6"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey7"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="7"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey8"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="8"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey9"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="9"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBiometric"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                app:icon="@drawable/ic_fingerprint"
                app:iconTint="@color/green_primary"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKey0"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeyBackspace"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                app:icon="@drawable/ic_backspace"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />
        </GridLayout>

        <!-- Cancel / Negative Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAuthCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
