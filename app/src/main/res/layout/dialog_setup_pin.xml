<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#1A222A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- Icon Header -->
        <ImageView
            android:id="@+id/ivSetupIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/green_primary" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvSetupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Set Master PIN"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtitle / Instruction -->
        <TextView
            android:id="@+id/tvSetupSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Enter a 4-digit PIN"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- PIN Entry Dots Indicator -->
        <LinearLayout
            android:id="@+id/llSetupPinDots"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/setupDot1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/setupDot2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/setupDot3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/setupDot4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="6dp"
                android:background="@drawable/bg_pin_dot_empty" />
        </LinearLayout>

        <!-- Keypad Grid -->
        <GridLayout
            android:id="@+id/gridSetupKeypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="3"
            android:rowCount="4"
            android:alignmentMode="alignMargins">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="4"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey5"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="5"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey6"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="6"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey7"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="7"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey8"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="8"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey9"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="9"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey0"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKeyBackspace"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_margin="6dp"
                app:icon="@drawable/ic_backspace"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:backgroundTint="#25323E"
                app:cornerRadius="32dp" />
        </GridLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetupCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cancel"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
