<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="36dp"
    app:cardElevation="24dp"
    app:cardBackgroundColor="#121D26"
    app:strokeWidth="1.5dp"
    app:strokeColor="#253848">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Glassmorphic Icon Header attached above title -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#162531"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/green_primary">

            <ImageView
                android:id="@+id/ivSetupIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                app:tint="@color/green_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <TextView
            android:id="@+id/tvSetupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Set Master PIN"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtitle / Instruction -->
        <TextView
            android:id="@+id/tvSetupSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Enter a 4-digit PIN"
            android:textColor="#8A9BA8"
            android:textSize="14sp" />

        <!-- PIN Entry Dots Indicator with generous breathing room -->
        <LinearLayout
            android:id="@+id/llSetupPinDots"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/setupDot1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/setupDot2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/setupDot3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_pin_dot_empty" />

            <View
                android:id="@+id/setupDot4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_margin="10dp"
                android:background="@drawable/bg_pin_dot_empty" />
        </LinearLayout>

        <!-- Keypad Grid with optimal 70dp touch targets -->
        <GridLayout
            android:id="@+id/gridSetupKeypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="3"
            android:rowCount="4"
            android:alignmentMode="alignMargins">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                android:text="4"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey5"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                android:text="5"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey6"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                android:text="6"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey7"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                android:text="7"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey8"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                android:text="8"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey9"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                android:text="9"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />

            <View
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKey0"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSetupKeyBackspace"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="7dp"
                app:icon="@drawable/ic_backspace"
                app:iconTint="@android:color/white"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:backgroundTint="#192734"
                app:cornerRadius="35dp"
                app:strokeWidth="1dp"
                app:strokeColor="#243748" />
        </GridLayout>

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetupCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cancel"
            android:textColor="#8A9BA8"
            android:textSize="15sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
