<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".ui.fragments.AiConnectorFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_primary"
        app:elevation="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="@dimen/spacing_16">

            <TextView
                android:id="@+id/titleAiConnector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="AI Order Connector"
                style="@style/TextAppearance.App.TitleLarge" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Ready to Pair"
                app:chipBackgroundColor="@color/card_green"
                app:chipStrokeColor="@color/green_primary"
                app:chipStrokeWidth="1dp" />
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/bottom_padding_for_nav"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- AI Connection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Model Context Protocol (MCP) Bridge"
                        style="@style/TextAppearance.App.TitleMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="Connect ChatGPT, Claude, or Gemini to allow AI agents to manage custom spaces, track progress, read/write inventory, and generate workspace cards."
                        style="@style/TextAppearance.App.BodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateToken"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:text="Generate Pairing Token"
                        app:backgroundTint="@color/green_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyEndpoint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="Copy MCP Endpoint URL"
                        style="?attr/materialButtonOutlinedStyle"
                        app:strokeColor="@color/green_primary"
                        android:textColor="@color/green_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_8"
                        android:text="Test Custom Space CRUD &amp; Card Gen"
                        style="?attr/materialButtonOutlinedStyle"
                        app:strokeColor="@color/green_primary"
                        android:textColor="@color/green_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Capabilities Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="Authorized Capabilities"
                style="@style/TextAppearance.App.TitleMedium" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Custom Space CRUD (Read, Write, Edit, Create)"
                        style="@style/TextAppearance.App.BodyMedium"
                        android:layout_marginBottom="@dimen/spacing_8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Dynamic Card &amp; Widget Generation"
                        style="@style/TextAppearance.App.BodyMedium"
                        android:layout_marginBottom="@dimen/spacing_8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Student Streak &amp; Study Task Synchronization"
                        style="@style/TextAppearance.App.BodyMedium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Activity Audit Log -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="AI Agent Activity Log"
                style="@style/TextAppearance.App.TitleMedium" />

            <TextView
                android:id="@+id/tvActivityLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="No recent AI interactions recorded. Ready for connection."
                style="@style/TextAppearance.App.BodyMedium"
                android:padding="@dimen/spacing_12"
                android:background="@color/surface_card" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
