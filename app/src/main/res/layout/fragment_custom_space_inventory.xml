<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/layoutStandardHeader"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingHorizontal="@dimen/spacing_8">
                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:src="@drawable/outline_arrow_back_24"
                    app:tint="@color/text_primary" />
                <TextView
                    android:id="@+id/tvSpaceTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Space Inventory"
                    style="@style/TextAppearance.App.TitleMedium" />
                <ImageView
                    android:id="@+id/btnMoreOptions"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/text_primary" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/layoutSelectionHeader"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:paddingHorizontal="@dimen/spacing_16"
                android:visibility="gone"
                android:background="@color/bg_secondary">
                <ImageView
                    android:id="@+id/btnCloseSelection"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_primary" />
                <CheckBox
                    android:id="@+id/cbSelectAll"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:layout_toEndOf="@id/btnCloseSelection"
                    android:button="@drawable/ic_check_tick"
                    android:buttonTint="@color/green_primary" />
                <TextView
                    android:id="@+id/tvSelectionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/spacing_12"
                    android:layout_toEndOf="@id/cbSelectAll"
                    android:text="0 selected"
                    style="@style/TextAppearance.App.TitleMedium" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnShareSelected"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="12dp"
                        android:src="@drawable/ic_share"
                        app:tint="@color/green_primary" />

                    <ImageView
                        android:id="@+id/btnDeleteSelected"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="12dp"
                        android:src="@drawable/outline_delete_24"
                        app:tint="@color/red_expired" />
                </LinearLayout>
            </RelativeLayout>
        </FrameLayout>

        <!-- Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvBanner"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/spacing_24"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutBanner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_banner_gradient"
                android:padding="@dimen/spacing_20">
                <TextView
                    android:id="@+id/tvBannerMsg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="100dp"
                    android:text="Keep tracking your items to stay organized!"
                    android:textColor="@color/white"
                    style="@style/TextAppearance.App.TitleMedium"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressOverall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:layout_marginEnd="@dimen/spacing_16"
                    android:progress="40"
                    app:indicatorColor="@color/white"
                    app:layout_constraintEnd_toStartOf="@+id/ivBannerIllustration"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvBannerMsg"
                    app:trackColor="#4DFFFFFF"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />
                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:text="40% Completed"
                    android:textColor="@color/white"
                    style="@style/TextAppearance.App.LabelLarge"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/progressOverall" />
                <ImageView
                    android:id="@+id/ivBannerIllustration"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/bellbrain_img_memorysection"
                    android:alpha="0.9"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/spacing_16"
            app:cardBackgroundColor="@color/bg_secondary"
            app:cardCornerRadius="@dimen/radius_pill"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider_color">
            <SearchView
                android:id="@+id/searchView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:iconifiedByDefault="false"
                android:queryBackground="@android:color/transparent"
                android:queryHint="Search items..." />
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSpaceItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/screen_padding"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/bottom_padding_for_nav" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingHorizontal="@dimen/screen_padding">

            <ImageView
                android:id="@+id/ivEmptyIllustration"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:alpha="0.5"
                android:src="@drawable/bellbrain_img_memorysection" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="No items found"
                style="@style/TextAppearance.App.TitleMedium" />

            <TextView
                android:id="@+id/tvProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="Start adding items to see your progress!"
                style="@style/TextAppearance.App.BodyMedium"
                android:textAlignment="center" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="96dp"
        android:contentDescription="@string/add_item"
        android:src="@drawable/ic_add"
        android:stateListAnimator="@animator/btn_press_animator"
        app:tint="@color/white"
        app:backgroundTint="@color/green_primary"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>