<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    tools:context=".ui.fragments.HomeFragment">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/bottom_padding_for_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingTop="@dimen/spacing_16">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="@dimen/spacing_8">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/ll_logo_container"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hello_ayush"
                        style="@style/TextAppearance.App.TitleMedium" />

                    <TextView
                        android:id="@+id/tv_user_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hello_cooking_today"
                        style="@style/TextAppearance.App.BodyMedium"
                        android:ellipsize="end"
                        android:maxLines="2"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_logo_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageView3"
                        android:layout_width="97dp"
                        android:layout_height="28dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/shadow" />

                    <TextView
                        android:id="@+id/textView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/smart_food_manager"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"/>
                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/pfp01"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    tools:srcCompat="@mipmap/ic_launcher" />

            </RelativeLayout>

            <!-- Reminder Health Check Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_health_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/card_red"
                app:strokeWidth="1dp"
                app:strokeColor="@color/badge_red_text">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_12"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_health_check_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_attention_red"
                        app:tint="@color/badge_red_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_health_check_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Reminders are Disabled"
                            android:textColor="@color/badge_red_text"
                            style="@style/TextAppearance.App.TitleMedium"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_health_check_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enable permissions to get alerts."
                            android:textColor="@color/text_secondary"
                            style="@style/TextAppearance.App.BodyMedium"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_fix_reminders"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fix"
                        android:textColor="@color/badge_red_text"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Bar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_home_search"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginVertical="@dimen/spacing_16"
                app:cardBackgroundColor="@color/bg_secondary"
                app:cardCornerRadius="@dimen/radius_pill"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider_color">

                <SearchView
                    android:id="@+id/home_searchbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:iconifiedByDefault="false"
                    android:queryBackground="@android:color/transparent"
                    android:queryHint="Search items.." />
            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Section Toggle Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_8"
                android:paddingHorizontal="@dimen/spacing_4">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/quick_input_title"
                    style="@style/TextAppearance.App.TitleMedium"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_shortcode"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="0dp"
                    app:icon="@drawable/ic_sparkle"
                    app:iconTint="@color/green_primary"
                    app:backgroundTint="@color/green_pale"
                    android:contentDescription="@string/toggle_quick_actions_desc" />
            </LinearLayout>

            <!-- Fast Natural Input (Short Code) -->
            <LinearLayout
                android:id="@+id/ll_home_shortcode_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_16">

                <!-- Suggestion Chips for Discovery -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="@dimen/spacing_8">
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cg_home_input_suggestions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_home_magic_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_secondary"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="0dp"
                    app:strokeWidth="1.5dp"
                    app:strokeColor="@color/green_primary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_12">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="@dimen/spacing_8"
                                app:srcCompat="@drawable/ic_sparkle"
                                app:tint="@color/green_primary" />

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_home_short_code"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="What did you bring home? Try '3 Milk exp 12/28'"
                                android:inputType="text"
                                android:padding="@dimen/spacing_12"
                                android:textSize="14sp" />

                            <ImageButton
                                android:id="@+id/btn_quick_add_submit"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:srcCompat="@drawable/ic_add"
                                app:tint="@color/green_primary" />
                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:scrollbars="none">
                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/cg_home_parsing_feedback"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                app:singleLine="true" />
                        </HorizontalScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Professional Result Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_universal_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:visibility="gone"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/divider_color">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/spacing_16"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_result_icon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="8dp"
                            android:background="@drawable/bg_badge_purple"
                            android:backgroundTint="@color/green_pale"
                            android:src="@drawable/v02_img_icons_shopping"
                            app:tint="@color/green_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_16"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_result_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Success!"
                                android:textColor="@color/green_primary"
                                style="@style/TextAppearance.App.TitleMedium"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_result_details"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Parsed details"
                                style="@style/TextAppearance.App.BodyMedium"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btn_close_result"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Needs your attention section -->
            <LinearLayout
                android:id="@+id/ll_attention_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16">

                    <ImageView
                        android:id="@+id/iv_attention_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_attention_red" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/iv_attention_icon"
                        android:layout_marginStart="@dimen/spacing_12"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_attention_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/needs_attention"
                            style="@style/TextAppearance.App.TitleMedium" />

                        <TextView
                            android:id="@+id/tv_attention_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/attention_count_default"
                            style="@style/TextAppearance.App.BodyMedium" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_view_all_attention"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="@string/view_all_attention_text"
                        android:textColor="@color/badge_red_text"
                        style="@style/TextAppearance.App.LabelLarge" />
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_attention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_attention"
                    tools:visibility="visible" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_attention_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_8"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:alpha="0.7"
                        android:scaleType="fitCenter"
                        android:src="@drawable/attention_alert_img" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Quick Add Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ll_quick_add_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_4"
                    android:paddingVertical="@dimen/spacing_8">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/quick_add_title"
                        style="@style/TextAppearance.App.TitleMedium"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/iv_expand_arrow"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="0dp"
                        android:clickable="false"
                        android:focusable="false"
                        app:icon="@drawable/outline_chevron_right_24"
                        app:iconTint="@color/green_primary"
                        app:backgroundTint="@color/green_pale"
                        android:contentDescription="@string/toggle_quick_actions_desc" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_quick_add_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="@dimen/spacing_8"
                    android:visibility="gone">

                    <!-- Food -->
                    <LinearLayout
                        android:id="@+id/btn_add_food"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/green_pale"
                            android:layout_marginBottom="@dimen/spacing_4">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_quick_fridge"
                                app:tint="@color/green_primary"
                                android:layout_gravity="center" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/food_label"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- Medicine -->
                    <LinearLayout
                        android:id="@+id/btn_add_medicine"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/badge_purple_bg"
                            android:layout_marginBottom="@dimen/spacing_4">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_quick_medicine"
                                app:tint="@color/purple_primary"
                                android:layout_gravity="center" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/medicine_label"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- To-Do -->
                    <LinearLayout
                        android:id="@+id/btn_add_todo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/badge_orange_bg"
                            android:layout_marginBottom="@dimen/spacing_4">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_todo_item"
                                app:tint="@color/orange_warning"
                                android:layout_gravity="center" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/todo_label"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- Shopping -->
                    <LinearLayout
                        android:id="@+id/btn_add_shopping"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/green_pale"
                            android:layout_marginBottom="@dimen/spacing_4">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_quick_shopping"
                                app:tint="@color/green_primary"
                                android:layout_gravity="center" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/shopping_label"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- Document -->
                    <LinearLayout
                        android:id="@+id/btn_add_document"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp"
                            app:cardBackgroundColor="@color/doc_banner_bg"
                            android:layout_marginBottom="@dimen/spacing_4">
                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="12dp"
                                android:src="@drawable/ic_quick_document"
                                app:tint="@color/doc_primary"
                                android:layout_gravity="center" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/documents_header"
                            style="@style/TextAppearance.App.LabelLarge"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Insights Section -->
            <TextView
                android:id="@+id/tv_insight_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/todays_insights"
                style="@style/TextAppearance.App.TitleMedium" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_today_insight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_insight_gradient"
                    android:padding="@dimen/spacing_24">

                    <LinearLayout
                        android:id="@+id/ll_insight_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_purple"
                        android:backgroundTint="#33FFFFFF"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_brain_memory"
                            app:tint="@color/white" />
                        <TextView
                            android:id="@+id/tv_insight_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/todays_insight_label"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_insight_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_new"
                        android:backgroundTint="#FFD700"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="@string/new_badge_label"
                        android:textColor="@color/black"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/ll_insight_tag"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/ll_insight_tag" />

                    <ImageView
                        android:id="@+id/iv_insight_illustration"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:background="@drawable/glow_bulb_mint"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/insight_img"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ll_insight_tag" />

                    <TextView
                        android:id="@+id/tv_insight_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:text="@string/insight_heading_default"
                        android:textColor="@color/white"
                        style="@style/TextAppearance.App.TitleMedium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_insight_illustration"
                        app:layout_constraintTop_toTopOf="@id/iv_insight_illustration" />

                    <TextView
                        android:id="@+id/tv_insight_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/insight_desc_default"
                        android:textColor="#E1D7FF"
                        style="@style/TextAppearance.App.BodyMedium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_insight_illustration"
                        app:layout_constraintTop_toBottomOf="@id/tv_insight_title" />

                    <TextView
                        android:id="@+id/btn_insight_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:background="@drawable/bg_badge_purple"
                        android:backgroundTint="#33FFFFFF"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:text="@string/take_action"
                        android:textColor="@color/white"
                        style="@style/TextAppearance.App.LabelLarge"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_insight_description" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Smart Tip Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_smart_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/card_green">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_20"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/green_primary" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/smart_chef_tip_title"
                            android:textColor="@color/green_primary"
                            style="@style/TextAppearance.App.LabelLarge" />
                        <TextView
                            android:id="@+id/tv_smart_tip_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/smart_chef_tip_default"
                            style="@style/TextAppearance.App.BodyMedium"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recent Activity Section -->
            <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/recent_activity_title"
                style="@style/TextAppearance.App.TitleMedium"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_recent_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_recent_activity" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>