<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_view"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:id="@+id/lyt_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_attention_card">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Expires today"
                tools:textColor="@color/premium_red_text"
                tools:ignore="SmallSp" />

        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="92dp"
            android:layout_height="68dp"
            app:cardCornerRadius="18dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="@color/attention_well_bg"
            app:cardElevation="0dp"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/iv_item_image"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/vegi_img01"
                tools:ignore="ContentDescription" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tomato"
            android:textColor="@color/attention_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_status_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                app:srcCompat="@drawable/baseline_circle_24"
                tools:tint="@color/premium_orange_text"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="In Fridge"
                android:textColor="@color/attention_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Use today for best freshness."
            android:textColor="@color/attention_text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/btn_view_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_attention_action"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <TextView
                android:id="@+id/tv_action_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="View"
                android:textColor="@color/attention_action_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iv_action_chevron"
                android:layout_width="12dp"
                android:layout_height="12dp"
                app:srcCompat="@drawable/outline_chevron_right_24"
                app:tint="@color/attention_action_text"
                tools:ignore="ContentDescription" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
