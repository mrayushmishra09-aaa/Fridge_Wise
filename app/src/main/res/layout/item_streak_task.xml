<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_streak_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Checkbox/Check Circle -->
    <ImageView
        android:id="@+id/ivTaskCheck"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Check Task"
        android:src="@drawable/ic_checkbox_custom" />

    <!-- Task Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/streak_text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Java practice" />

        <TextView
            android:id="@+id/tvTaskSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/streak_text_secondary"
            android:textSize="12sp"
            tools:text="10:00 AM • Study" />
    </LinearLayout>

    <!-- Priority Badge -->
    <TextView
        android:id="@+id/tvTaskPriority"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_priority_high_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/streak_prio_high_text"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="High" />



</LinearLayout>