<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivNotifyFlame"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="Streak Flame"
            android:src="@drawable/ic_flame" />

        <TextView
            android:id="@+id/tvNotifyStreakTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:layout_toEndOf="@id/ivNotifyFlame"
            android:text="🔥 7 Day Streak Active"
            android:textColor="@color/streak_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNotifyPercentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_stat_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="82%"
            android:textColor="@color/streak_chip_selected_bg"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Subtitle Motivational Message -->
    <TextView
        android:id="@+id/tvNotifyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="You're on fire! 8 of 10 tasks completed today."
        android:textColor="@color/streak_text_secondary"
        android:textSize="12sp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pbNotifyStreak"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="82"
        android:progressDrawable="@drawable/custom_progress_bar_streak" />

</LinearLayout>